{
  "uid": "restohub-inventory",
  "title": "RestoHub — Inventory Service",
  "tags": ["restohub", "inventory"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests por segundo",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(django_http_requests_total_by_method_total{job=\"inventory_service\"}[1m])) by (method)",
          "legendFormat": "{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 2,
      "title": "Tasa de errores HTTP (4xx / 5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"inventory_service\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        },
        {
          "expr": "sum(rate(django_http_responses_total_by_status_total{job=\"inventory_service\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 3,
      "title": "Latencia P50 / P95 / P99 (ms)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"inventory_service\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"inventory_service\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(django_http_requests_latency_seconds_by_view_method_bucket{job=\"inventory_service\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 4,
      "title": "Servicio activo",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"inventory_service\"}",
          "legendFormat": "inventory_service",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 5,
      "title": "Requests por view (top 10)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum(rate(django_http_requests_latency_seconds_by_view_method_count{job=\"inventory_service\"}[5m])) by (view))",
          "legendFormat": "{{view}}",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 6,
      "title": "Conexiones DB activas",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "django_db_connections_total{job=\"inventory_service\"}",
          "legendFormat": "{{alias}}",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 7,
      "title": "Queries DB por segundo",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(django_db_execute_many_total{job=\"inventory_service\"}[1m]))",
          "legendFormat": "execute_many",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        },
        {
          "expr": "sum(rate(django_db_errors_total{job=\"inventory_service\"}[1m]))",
          "legendFormat": "errors",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 8,
      "title": "Migraciones aplicadas",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "django_migrations_applied_total{job=\"inventory_service\"}",
          "legendFormat": "Aplicadas",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 9,
      "title": "Total requests acumulados",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(django_http_requests_total_by_method_total{job=\"inventory_service\"})",
          "legendFormat": "Total",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    },
    {
      "id": 10,
      "title": "Requests con error acumulados",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum(django_http_responses_total_by_status_total{job=\"inventory_service\", status=~\"[45]..\"})",
          "legendFormat": "Errores",
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-restohub-prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errores"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-restohub-prom"
      }
    }
  ],
  "__inputs__": [
    {
      "name": "DS_GRAFANACLOUD",
      "label": "grafanacloud-restohub-prom",
      "type": "datasource",
      "pluginId": "prometheus",
      "value": "grafanacloud-restohub-prom"
    }
  ]
}
